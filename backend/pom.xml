<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.1.0</version>
    <relativePath/>
  </parent>

  <groupId>com.alai</groupId>
  <artifactId>entitlements-backend</artifactId>
  <version>0.1.0</version>
  <name>entitlements-backend</name>
  <description>Access list API for the Entitlement Description POC</description>

  <properties>
    <java.version>25</java.version>
    <!--
      Spring Boot 4.1.0's own dependency management no longer pins individual
      Testcontainers module versions - Testcontainers had a major 1.x -> 2.x bump
      (removed JUnit4, renamed artifacts e.g. postgresql -> testcontainers-postgresql,
      moved classes to new packages) around the same time. We pin the last 1.x
      release deliberately: the code here uses the 1.x API
      (org.testcontainers.containers.PostgreSQLContainer, artifactId "postgresql"),
      and 2.x's @ServiceConnection support was still being finalized upstream at
      time of writing. Revisit this pin if you want to move to 2.x later.
    -->
    <testcontainers.version>1.21.3</testcontainers.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-webmvc</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-tomcat</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-jackson</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-jpa</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>
    <!--
      Compile (not test) scope, deliberately. This was originally test-scoped on
      the theory that it was only needed for JdbcTemplateAutoConfiguration in
      test sources - WRONG, confirmed by an actual container crash at runtime:
      spring-boot-starter-data-jpa does NOT transitively pull in
      DataSourceAutoConfiguration, so without this at compile/runtime scope,
      Hibernate/JPA autoconfiguration fails to create a DataSource bean at all,
      and every @Repository fails to wire (UserRepository, in this case).
      Test-scope dependencies are stripped from the packaged jar, so this only
      broke in the Docker container, not in `mvn spring-boot:run` on the host
      where the class was presumably still resolvable from another scope.
    -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-jdbc</artifactId>
    </dependency>
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>

    <!--
      NOTE: spring-boot-starter-classic / spring-boot-starter-test-classic were
      tried here and REMOVED - they register auto-configuration for every
      technology Spring Boot supports (gRPC, Thymeleaf, OAuth2, SAML2, Mustache...),
      and @WebMvcTest's context tried to resolve all of it, crashing with
      ClassNotFoundException on org.springframework.grpc...GrpcServerStartedEvent
      (a type we have no dependency on). Declaring exact modules instead, confirmed
      against the real classes in the local .m2 cache:
        @DataJpaTest              -> spring-boot-data-jpa-test
        @WebMvcTest                -> spring-boot-webmvc-test
        @AutoConfigureTestDatabase  -> spring-boot-jdbc-test
      (spring-boot-jdbc itself moved to compile scope above - see that dependency's
      comment for why.)
    -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-data-jpa-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-webmvc-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-jdbc-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-testcontainers</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>postgresql</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.testcontainers</groupId>
        <artifactId>testcontainers-bom</artifactId>
        <version>${testcontainers.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <finalName>entitlements-backend</finalName>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
